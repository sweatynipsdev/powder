{
  "name": "powder",
  "private": true,
  "version": "0.1.0",
  "description": "Personal snow forecast PWA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx pipeline/run.ts",
    "pipeline:replay": "POWDER_FIXTURES=replay tsx pipeline/run.ts",
    "record-fixtures": "POWDER_FIXTURES=record tsx pipeline/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "analyze": "tsx analysis/run.ts",
    "analyze:sample": "tsx analysis/run.ts --sample",
    "calibrate": "tsx scripts/calibrate.ts",
    "reuse-data": "tsx scripts/reuse-data.ts",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
